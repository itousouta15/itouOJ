# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
dev.db
test.db
*.db-journal

# 比賽選手帳密名單（scripts/contest-accounts.mjs 產出，含明碼密碼）
contest-accounts-*.csv

# 收件程式的建置產物（用 client/build.ps1 重建）
client/*.exe
client/*.pdb

# Capacitor 原生專案建置產物（用 npx cap sync android 重建）
android/.gradle/
android/build/
android/app/build/
android/.idea/
android/local.properties
android/capacitor-cordova-android-plugins/build/
android/app/src/main/assets/
*.apk
*.aab

AGENTS.md
# 題目匯出（scripts/export-problems.mjs 產出，可隨時重新產生）
problem-docs/

# 未公開比賽的出題 script：明碼版只留在本機，git 裡只放加密過的 .enc
# （openssl enc -aes-256-cbc -pbkdf2 -iter 200000，密碼另外管道傳遞）
scripts/add-ticket-grabbing-bot-problem.mjs
scripts/add-volleyball-culprit-problem.mjs

# 建置產物：每次重建都會變（舊版 csc 不支援 /deterministic）
client/dist/
