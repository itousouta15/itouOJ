[Unit]
Description=Online Judge remote host management agent
After=network-online.target online-judge-control.service
Wants=network-online.target
Requires=online-judge-control.service

[Service]
Type=simple
User=oj
Group=oj
WorkingDirectory=/opt/online-judge
Environment=NODE_ENV=production
# Must contain JUDGE_WORKER_URL and the one-time JUDGE_WORKER_SECRET.
EnvironmentFile=/etc/online-judge/remote-managed.env
ExecStart=/usr/bin/node scripts/host-agent.mjs
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
