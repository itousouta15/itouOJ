generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String               @id @default(cuid())
  username     String               @unique
  passwordHash String? // null = Google 帳號，沒有本地密碼
  googleId     String?              @unique // Google 帳號的 sub
  discordId    String?              @unique // Discord 帳號的 id
  email        String? // 目前只有 Google / Discord 登入會帶入
  role         String               @default("USER") // USER | ADMIN
  displayName  String? // 顯示名稱（未設定時顯示 username）
  bio          String? // 自我介紹
  createdAt    DateTime             @default(now())
  submissions  Submission[]
  courses      CourseMember[]
  contests     ContestParticipant[]
  problemProposals ProblemProposal[]
}

model Problem {
  id              Int              @id @default(autoincrement())
  title           String
  statement       String // Markdown，支援數學式
  difficulty      String           @default("medium") // easy | medium | hard
  timeLimitMs     Int              @default(1000)
  memoryLimitMb   Int              @default(256)
  isPublic        Boolean          @default(true)
  order           Int              @default(0) @unique // 題目列表顯示順序；同時是對外題號（網址 /problems/{order}）
  // 管理員自製的正式題目檔（通常是排版過的 PDF）。沒有上傳的話，下載題目文件時
  // 會退回用 statement 現場產生的 HTML（見 lib/renderProblemDoc.ts）。
  // 掛在 Problem 而不是 ContestProblem：後者每次比賽編輯存檔都會整批刪除重建
  // （見 admin/contests/[id] 的 PUT），掛在那裡的話存檔就把上傳的檔案弄丟了。
  pdfData         Bytes?
  pdfFilename     String?
  pdfUploadedAt   DateTime?
  // 有設定的話 pdfData 是用這組密碼加密過的（AES-256-CBC，見 lib/pdfCrypto.ts），
  // 不是明碼 PDF。斷網比賽賽前把加密檔跟密碼一起佈署到選手機上，收件程式
  // 在開賽前不會解密開啟；開賽那一刻才自動解密——檔案早佈署到手也打不開，
  // 比純粹的按鈕鎖多一層真正的加密保護。
  pdfPassword     String?
  createdAt       DateTime         @default(now())
  testCases       TestCase[]
  subtasks        Subtask[] // 有設定才走部分給分；沒有則維持整題 AC/WA
  submissions     Submission[]
  courseProblems  CourseProblem[]
  contestProblems ContestProblem[]
  tags            ProblemTag[]
}

// 標籤庫：管理員統一建立/管理，題目從中勾選，避免同義詞打散（如「字串」跟「string」變兩個標籤）
model Tag {
  id       Int          @id @default(autoincrement())
  name     String       @unique
  problems ProblemTag[]
}

model ProblemTag {
  problemId Int
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  tagId     Int
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([problemId, tagId])
}

// 子題：把一題的測資分組並各自配分，用於部分給分。
// 一題若完全沒有 Subtask，代表沿用舊制「整題只有 AC/WA」，不計分數。
model Subtask {
  id        Int        @id @default(autoincrement())
  problemId Int
  problem   Problem    @relation(fields: [problemId], references: [id], onDelete: Cascade)
  order     Int        @default(0) // 子題序號（1, 2, 3...），決定配分表與判題順序
  points    Int // 此子題配分；一題的所有子題配分總和應為 100
  // full = 完整比對輸出；firstLine = 只比對輸出第一行，其餘內容忽略
  // （對應「只要某一行對就給分、後面明細寫錯不扣分」這種官方配分規則）
  checkMode String     @default("full")
  testCases TestCase[]

  @@unique([problemId, order])
}

// 題單型課程：一組題目 + 說明，使用者加入後追蹤解題進度
model Course {
  id          Int             @id @default(autoincrement())
  title       String
  description String          @default("")
  isPublic    Boolean         @default(true)
  joinCode    String? // 加入代碼；null = 開放任何人加入
  createdAt   DateTime        @default(now())
  problems    CourseProblem[]
  members     CourseMember[]
}

model CourseProblem {
  id        Int     @id @default(autoincrement())
  courseId  Int
  course    Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  problemId Int
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  order     Int     @default(0)

  @@unique([courseId, problemId])
}

model CourseMember {
  id       Int      @id @default(autoincrement())
  courseId Int
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now())

  @@unique([courseId, userId])
}

// 有起訖時間的小型比賽：只有比賽期間的提交才計分，罰時排名 + 賽末凍結榜
model Contest {
  id            Int                  @id @default(autoincrement())
  title         String
  description   String               @default("")
  startTime     DateTime
  endTime       DateTime
  freezeMinutes Int                  @default(0) // 0 = 不凍結
  // ICPC = 首次 AC 計分、錯誤提交罰時 20 分；IOI = 每題只看最後一次提交、不罰時。
  // 斷網比賽judge在賽後才跑，選手當下看不到結果，罰時會變成盲罰，所以用 IOI。
  scoreMode     String               @default("ICPC") // ICPC | IOI
  // 允許的語言，逗號分隔（例如 "cpp" 或 "cpp,python"）。空字串 = 不限制。
  // SQLite 沒有陣列型別，所以用字串存；解析見 lib/contest.ts 的 parseAllowedLanguages。
  allowedLanguages String            @default("")
  isPublic      Boolean              @default(true)
  joinCode      String? // 加入代碼；null = 開放任何人加入
  revealedAt    DateTime? // 管理員手動「公開最終成績」的時間；null = 尚未公開
  // 預設關閉：題目文件（PDF/HTML）平常要等開賽才給選手端下載，避免洩題。
  // 管理員針對個別比賽自行評估風險後才能開啟，讓斷網比賽在賽前設定階段
  // 就把檔案下載到選手機——開啟後「有沒有洩題風險」是管理員自己承擔的判斷，
  // 不是系統預設行為。
  allowEarlyProblemDownload Boolean  @default(false)
  createdAt     DateTime             @default(now())
  problems      ContestProblem[]
  participants  ContestParticipant[]
  submissions   Submission[]
}

model ContestProblem {
  id        Int     @id @default(autoincrement())
  contestId Int
  contest   Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  problemId Int
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  label     String // "A" "B" "C" ...
  order     Int     @default(0)

  @@unique([contestId, problemId])
  @@unique([contestId, label])
}

model ContestParticipant {
  id        Int      @id @default(autoincrement())
  contestId Int
  contest   Contest  @relation(fields: [contestId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt  DateTime @default(now())
  // 離線收件程式設定完成後回報的「這台機器準備好了」。斷網比賽開賽前，
  // 監考要能一眼看出哪一台還沒設定好——漏一台那個選手整場都交不出東西。
  clientReadyAt DateTime?
  clientHost    String? // 回報的電腦名稱，方便對照是機房哪一台
  // 回報的收件程式版本號（例如 "1.2.11"）。監考巡場時可以一眼看出
  // 哪幾台還在跑舊版——尤其是開程式前自動更新失敗（沒網路、被防毒擋下）的機器。
  clientVersion String?

  @@unique([contestId, userId])
}

model Announcement {
  id        Int      @id @default(autoincrement())
  title     String
  content   String // Markdown
  isPinned  Boolean  @default(false) // 置頂公告固定顯示在最上面
  createdAt DateTime @default(now())
}

// 使用者投稿的出題申請；審核通過後才會建立成正式的 Problem
model ProblemProposal {
  id                Int                @id @default(autoincrement())
  title             String
  statement         String
  difficulty        String             @default("medium")
  timeLimitMs       Int                @default(1000)
  memoryLimitMb     Int                @default(256)
  status            String             @default("PENDING") // PENDING | APPROVED | REJECTED
  reviewNote        String? // 管理員退回原因；核准後清空
  authorId          String
  author            User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  approvedProblemId Int? // 核准後建立的正式 Problem id
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  testCases         ProposalTestCase[]
}

model ProposalTestCase {
  id         Int             @id @default(autoincrement())
  proposalId Int
  proposal   ProblemProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  input      String
  output     String
  isSample   Boolean         @default(false)
  order      Int             @default(0)
}

model TestCase {
  id        Int      @id @default(autoincrement())
  problemId Int
  problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  subtaskId Int? // 有值才計入部分給分；null = 沿用舊制整題 AC/WA
  subtask   Subtask? @relation(fields: [subtaskId], references: [id], onDelete: Cascade)
  input     String
  output    String
  isSample  Boolean  @default(false) // 範例測資會顯示在題目頁
  order     Int      @default(0)
}

model Submission {
  id           Int          @id @default(autoincrement())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId    Int
  problem      Problem      @relation(fields: [problemId], references: [id], onDelete: Cascade)
  contestId    Int? // 有值 = 這是比賽期間的提交，計入該比賽罰時排名
  contest      Contest?     @relation(fields: [contestId], references: [id], onDelete: SetNull)
  language     String // cpp | c | python | java | javascript
  code         String
  status       String       @default("PENDING") // PENDING JUDGING AC WA TLE MLE RE CE IE
  compileError String?
  timeMs       Int? // 所有測資的最大值
  memoryKb     Int?
  score        Int? // 有部分給分（子題）的題目才會有值，範圍 0~該題子題配分總和；沒有子題的題目維持 null

  // 離線收件程式為每筆提交產生的去重鍵。選手重複按上傳時用它擋掉重複寫入，
  // 否則同一份程式會被灌成多筆、把 IOI 的「最後一次提交」和提交次數算錯。
  clientKey    String?      @unique
  createdAt    DateTime     @default(now())
  results      TestResult[]
}

model TestResult {
  id           Int        @id @default(autoincrement())
  submissionId Int
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  order        Int        @default(0)
  subtaskOrder Int? // 對應 Subtask.order；沒有子題的題目維持 null
  verdict      String // AC WA TLE MLE RE
  timeMs       Int?
  memoryKb     Int?
}
